# ---- Secrets: NEVER commit certificate/key material ----
*.pem
*.key
*.crt
*.csr

# ---- Tailscale pre-auth keys (expiring credentials) ----
secrets/

# ---- Private fleet operations (real hostnames/IPs) ----
servers/

# ---- Per-run execution folders (self-contained: plans, secrets, logs) ----
executions/

# ---- Local editor/agent state ----
.opencode/

# ---- Coder template variable files (contain certs) ----
templates/**/.tfvars
templates/**/*.tfvars.json
.tfvars
*.tfvars

# ---- Local scratch ----
generated/
*.local
.env
.env.*
!.env.example

# ---- OS / editor noise ----
.DS_Store
Thumbs.db
.idea/
.vscode/
__pycache__
