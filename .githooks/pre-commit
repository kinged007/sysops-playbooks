#!/bin/bash
# Safety net: dependency-free scan of staged changes. Always runs.
fail=0

while IFS= read -r -d '' f; do
  case "$f" in
    fleet/*.example.yaml)
      case "${f#fleet/}" in */*) echo "pre-commit: blocked path staged: $f" >&2; fail=1 ;; esac ;;
    fleet/*|vault/*|runs/*|executions/*|logs/*|secrets/*|*/secrets/*|ops.config.yaml|\
.ops-wake.state|.ops-wake.lock|.env|.env.*|*/.env|*/.env.*|*.key|*.pem|*.tfvars|*.tfvars.json|servers/*)
      case "$f" in
        .env.example|*/.env.example) ;;
        *) echo "pre-commit: blocked path staged: $f" >&2; fail=1 ;;
      esac ;;
    incidents/README.md|incidents/inbox.example.md) ;;
    incidents/*)
      echo "pre-commit: blocked path staged: $f" >&2; fail=1 ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

pattern='BEGIN (OPENSSH |RSA |EC |DSA )?(PRIVATE|CERTIFICATE)|BEGIN [A-Z ]*PRIVATE KEY|tskey-[A-Za-z0-9]|AKIA[0-9A-Z]{16}|sk-ant-|ghp_'
hits=$(git diff --cached -U0 --no-color | grep -E '^\+' | grep -vE '^\+\+\+ ' | grep -E -e "$pattern" || true)
if [ -n "$hits" ]; then
  echo "pre-commit: secret pattern in staged changes (content not shown)" >&2
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: commit blocked" >&2
  exit 1
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --config .gitleaks.toml --redact || exit 1
else
  echo "pre-commit: gitleaks not installed, skipped (https://github.com/gitleaks/gitleaks#installing)" >&2
fi
if ! command -v trufflehog >/dev/null 2>&1; then
  echo "pre-commit: trufflehog not installed, skipped (https://github.com/trufflesecurity/trufflehog#installation)" >&2
fi
exit 0
