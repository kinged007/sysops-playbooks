# Copy to .env (Dokploy: paste into the app's Environment tab instead).
# Never commit .env — it holds secrets. Generate fresh per deployment
# (alphanumeric only: Dokploy compose interpolation chokes on `$`).
HERMES_IMAGE=nousresearch/hermes-agent:stable
# Dashboard bootstrap (MANDATORY when the dashboard domain exists — the
# dashboard fails closed without an auth provider):
HERMES_DASHBOARD=1
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=change-me
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=change-me-long-random
HERMES_DASHBOARD_BASIC_AUTH_SECRET=change-me-32-chars-min
# Terminal creds (MANDATORY only if the term service is uncommented):
#TTYD_USER=change-me
#TTYD_PASS=change-me-long-random
