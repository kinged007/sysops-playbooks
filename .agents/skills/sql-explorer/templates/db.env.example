# DB_TYPE=postgres  # postgres | mysql | sqlite
# DB_HOST=<host>
# DB_PORT=<port>  # postgres 5432, mysql 3306 (omit for sqlite)
# DB_NAME=<database>  # sqlite: omit, use DB_PATH
# DB_USER=<user>
# DB_PASSWORD=<password>
# DB_SSLMODE=require  # postgres only; omit for local/trusted net
# DB_PATH=<path-to-file.db>  # sqlite only
