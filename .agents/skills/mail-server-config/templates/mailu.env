# Mailu environment — placeholder template. Copy to <MAILU_DIR>/mailu.env
# and fill every <PLACEHOLDER> from the run's plan.md + vault entries.
# Real values NEVER go into the committed repo (AGENTS.md §1.5, §7).
#
# Verified against Mailu 2024.06.

# --- Core ---
# Primary mail domain handled by this server
DOMAIN=<DOMAIN>
# Hostnames the server answers for / TLS certificate covers (comma list)
HOSTNAMES=mail.<DOMAIN>
# Local part of the postmaster address (postmaster@<DOMAIN>)
POSTMASTER=<POSTMASTER_LOCAL_PART>
# Site name shown in the admin/webmail UI
SITENAME=Mail Server

# --- Secrets (from the vault, never inline) ---
# 16 chars, uppercase alphanumeric (generate: tr -dc 'A-Z0-9' </dev/urandom | head -c16)
SECRET_KEY=<SECRET_KEY_REF>
# Password used by Mailu internals between containers
RSPAMD_PASSWORD=<RSPAMD_PASSWORD_REF>

# --- Initial admin account (created at first start) ---
INITIAL_ADMIN_ACCOUNT=<ADMIN_USER>
INITIAL_ADMIN_DOMAIN=<DOMAIN>
INITIAL_ADMIN_PW=<ADMIN_PASSWORD_REF>
INITIAL_ADMIN_MODE=ifmissing

# --- Database backend ---
# sqlite is fine for a single instance. For PostgreSQL set DB_FLAVOR *and* the
# discrete DB_* keys: 2024.06 ignores SQLALCHEMY_DATABASE_URI and falls back to
# sqlite when only that is set.
DB_FLAVOR=postgresql
DB_HOST=postgres
DB_USER=<DB_USER>
DB_PW=<DB_PASSWORD_REF>
DB_NAME=<DB_NAME>
# Must match DB_USER / DB_NAME / DB_PW above.
POSTGRES_USER=<DB_USER>
POSTGRES_DB=<DB_NAME>
POSTGRES_PASSWORD=<DB_PASSWORD_REF>
# Default per-mailbox quota in bytes (1000000000 = 1 GB)
DEFAULT_QUOTA=1000000000

# --- Components ---
# Virus scanning: none | clamav. ClamAV is the single heaviest component; "none"
# is a supported choice for a small server, not a default.
ANTIVIRUS=none
# Webmail: roundcube | none
WEBMAIL=roundcube
# WebDAV (CalDAV/CardDAV): none | radicale
WEBDAV=none
# POP3 (110/995) — leave off unless the client base needs it
POP3=false

# --- Exposed mail ports ---
# These drive the dovecot proxy listeners inside the front container. Each one that
# is absent makes the matching published port dead — a missing PORT_587 silently
# disables submission (dovecot binds port 0) with no error anywhere in the logs.
PORT_25=25
PORT_465=465
PORT_587=587
PORT_993=993
PORT_4190=4190
# Uncomment only with a reason: plaintext IMAP/POP3.
# PORT_143=143
# PORT_110=110
# PORT_995=995

# --- TLS ---
# cert (bring your own) | mail (self-signed) | letsencrypt
TLS_FLAVOR=cert
TLS_CERT_FLAVOR=cert
# Paths as seen INSIDE the front container (mount the host dir at /certs)
CERT_FILENAME=/certs/cert.pem
KEY_FILENAME=/certs/key.pem
# letsencrypt flavor instead:
# TLS_FLAVOR=letsencrypt
# LETSENCRYPT_EMAIL=<POSTMASTER_LOCAL_PART>@<DOMAIN>
TLS_PERMISSIVE=false

# --- Web UI paths ---
# Both are served by the front container's nginx; only reached if a reverse proxy
# routes the hostname to it.
WEB_ADMIN=/admin
WEB_WEBMAIL=/webmail
# Per-user self-service domain selection
DOMAIN_REGISTRATION=false
# Restrict domain admin to the global admin
ADMIN=true
# REST API for external tooling — off unless something calls it
API=false

# --- Misc (defaults; change only with a reason, record it) ---
# Log level: debug | info | warning | error
LOG_LEVEL=info
# Timezone for logs and admin UI
TZ=<TIMEZONE>
# Fixed networks — must not collide with anything else on the host
SUBNET=<SUBNET_V4>
SUBNET6=<SUBNET_V6>
# Container image org/prefix/version (kept in lockstep with docker-compose.yml).
# ghcr.io/mailu with an EMPTY prefix: the images are ghcr.io/mailu/nginx, /admin,
# /postfix, /dovecot, /rspamd, /webmail, /unbound, /redis.
DOCKER_ORG=ghcr.io/mailu
DOCKER_PREFIX=
MAILU_VERSION=<MAILU_VERSION>
# Compose project root dir (where this env file lives)
ROOT=<MAILU_DIR>
