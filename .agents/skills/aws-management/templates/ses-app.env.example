# SES my-tech.uk — application env (placeholders only — never commit real values)
# Region is mandatory: my-tech.uk only verified in eu-west-1
AWS_REGION=eu-west-1
AWS_SES_REGION=eu-west-1
SES_FROM=noreply@my-tech.uk
SES_CONFIGURATION_SET=
# For SMTP transport:
# SES_SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SES_SMTP_PORT=587
# SES_SMTP_USERNAME=<SMTP_USERNAME = AccessKeyId of ses-sender / ses-smtp user>
# SES_SMTP_PASSWORD=<SMTP_PASSWORD = derived via sigv4, NOT the raw Secret — see SKILL.md §1>
# For API transport (SDK):
# AWS_ACCESS_KEY_ID=<from execs/aws-management/secrets/aws-credentials.ses-sender.env>
# AWS_SECRET_ACCESS_KEY=<same>
