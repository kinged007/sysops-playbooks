# 9Router env — template for playbooks/9router
# Copy to <COMPOSE_DIR>/.env or <APP_DIR>/.env or <DATA_DIR>/.env depending on mode.
# Fill <PLACEHOLDERS> from executions/9router[-<suffix>]/secrets/ — never commit real values.
# Upstream reference: https://raw.githubusercontent.com/decolua/9router/master/.env.example
# and DOCKER.md / README env table.

# ---- Required ----
JWT_SECRET=<from secrets/jwt-secret.txt — openssl rand -base64 48>
INITIAL_PASSWORD=<from secrets/initial-password.txt — dashboard first login; rotate after>
DATA_DIR=/app/data
# Docker (B/C): must be /app/data inside the container (matches the volume).
# npm/source (A/D): e.g. /home/<user>/.9router or /var/lib/9router

# ---- Runtime ----
PORT=20128
HOSTNAME=0.0.0.0
NODE_ENV=production
# NODE_ENV=development for local dev only

# ---- Security & ops ----
API_KEY_SECRET=<from secrets/api-key-secret.txt — openssl rand -base64 32>
MACHINE_ID_SALT=<from secrets/machine-id-salt.txt — openssl rand -base64 16>
ENABLE_REQUEST_LOGS=false
# true only when triaging; verbose and disk-heavy (logs under DATA_DIR/logs/)
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
# true when behind HTTPS reverse proxy; false for localhost HTTP
REQUIRE_API_KEY=false
# true mandatory when internet-exposed; false for localhost-only

# ---- Cloud sync ----
# Server-side preferred (production):
BASE_URL=http://localhost:20128
# Replace with https://<DOMAIN> when reverse-proxied
CLOUD_URL=https://9router.com
# Backward-compatible public vars (still honored for UI):
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://9router.com
# Prefer BASE_URL/CLOUD_URL on the server; keep NEXT_PUBLIC_* only if the UI needs it.

# ---- Optional: outbound proxy for upstream provider calls ----
# Lowercase variants also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# ---- Optional: SearXNG for built-in web-search provider ----
# SEARXNG_URL=http://searxng:8080/search

# ---- Optional: Headroom ----
# HEADROOM_URL=http://headroom:8787
# Compose network (sidecar): http://headroom:8787
# Host-level Headroom (Linux): http://host.docker.internal:8787
#   + compose extra_hosts: ["host.docker.internal:host-gateway"]

# ---- Unused / reference (do not set) ----
# INSTANCE_NAME=9router
