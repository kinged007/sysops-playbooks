# OmniRoute .env example — copy to the run's .env and fill placeholders.
# NEVER commit real values. Generate secrets with playbooks/omniroute/scripts/gen-secrets.ps1
# and store them in the run's executions/<run>/secrets/.

# --- Required secrets (set before first run) ---
# Generate: openssl rand -base64 48
JWT_SECRET=<JWT_SECRET>
# Generate: openssl rand -hex 32
API_KEY_SECRET=<API_KEY_SECRET>
# Initial dashboard admin password (operator: change after first login).
INITIAL_PASSWORD=<INITIAL_PASSWORD>
# Required in production; rejects all WS bridge requests when unset.
# Generate: openssl rand -base64 32
OMNIROUTE_WS_BRIDGE_SECRET=<OMNIROUTE_WS_BRIDGE_SECRET>

# --- Salts (per-deployment; change from defaults for isolation) ---
MACHINE_ID_SALT=<MACHINE_ID_SALT>
OMNIROUTE_CLI_SALT=<OMNIROUTE_CLI_SALT>

# Optional: full SQLite encryption-at-rest. Losing this = losing data.
# Generate: openssl rand -hex 32
# STORAGE_ENCRYPTION_KEY=<STORAGE_ENCRYPTION_KEY>

# --- Network & ports ---
PORT=20128
# API_HOST=0.0.0.0
# DASHBOARD_PORT=
# API_PORT=

# --- URLs ---
# Public origin clients/agents will use (also for OAuth redirects).
# Set when running behind a reverse proxy / public hostname.
NEXT_PUBLIC_BASE_URL=<NEXT_PUBLIC_BASE_URL>
# Internal server-to-server URL (loopback / container name). Do NOT use the
# public hostname for credential-bearing self-fetches.
BASE_URL=<BASE_URL>
# Highest-priority browser-facing origin (set when a relay reaches OmniRoute by
# an internal URL but the browser must fetch from the public origin).
# OMNIROUTE_PUBLIC_BASE_URL=<OMNIROUTE_PUBLIC_BASE_URL>
# URL subpath behind a reverse proxy (e.g. /omniroute). "" = root.
# OMNIROUTE_BASE_PATH=

# --- Security ---
# Set true when the public URL is HTTPS (dashboard session cookies).
AUTH_COOKIE_SECURE=true
# Require a valid API key on all /v1/* proxy calls.
# REQUIRE_API_KEY=true
# Prompt-injection guard: warn (default) | block.
# INPUT_SANITIZER_MODE=warn
# LOCAL_ONLY carve-out for /api/mcp/* must stay enabled; allow remote MCP only
# via a manage / mcp:connect scoped API key. Do NOT set false here.
# localOnlyManageScopeBypassEnabled (dashboard setting, not env)

# --- Storage ---
# Docker: set DATA_DIR=/app/data
# DATA_DIR=~/.omniroute
# DISABLE_SQLITE_AUTO_BACKUP=false

# --- Redis (compose sidecar) ---
# REDIS_URL=redis://redis:6379
# REDIS_PORT=6379
# REDIS_BIND_HOST=127.0.0.1

# --- MCP server (enable via dashboard / PATCH /api/settings) ---
# mcpEnabled=true            (settings API, not env)
# mcpTransport=sse|streamable-http