# env.example — Kandev environment template for compose / systemd drop-in / launchd plist
# Placeholders are <ANGLE_BRACKETS>. Secrets shown here are NEVER committed — store real values in
# executions/kandev[-<suffix>]/secrets/env (0600) or a Kubernetes Secret (valueFrom.secretKeyRef).
# Load order: file values here win over config.yaml but are themselves the last source — restart after changes.
# Every KANDEV_* env name must be exact (case + underscores, no snake_case alias guessing) — see docs/configuration.

# ── Home — single removable root (Service: --home-dir <KANDEV_HOME_DIR>; Docker: fixed /data) ──────
KANDEV_HOME_DIR=<KANDEV_HOME_DIR>
# Examples: /srv/kandev (system isolated), ~/srv/kandev (user isolated), ~/.kandev (user default), /var/lib/kandev (system default)

# ── Server ───────────────────────────────────────────────────────────────────────────────────────────
KANDEV_SERVER_HOST=127.0.0.1
# KANDEV_SERVER_PORT / KANDEV_BACKEND_PORT / KANDEV_PORT — preferred port, but launcher may fall back (G2).
# Pin with a systemd drop-in Environment=KANDEV_BACKEND_PORT=<PORT> if a fixed port is required.
# KANDEV_BACKEND_PORT=<PORT>

# Trust the proxy peer(s) seen by Kandev — IP or narrow CIDR, comma-separated, NOT the client network.
# Missing/incorrect entry causes "ignoring X-Forwarded-Host from untrusted peer" and spoofable X-Forwarded-For.
KANDEV_TRUSTED_PROXIES=127.0.0.1
# KANDEV_TRUSTED_PROXIES=10.0.0.5
# KANDEV_TRUSTED_PROXIES=10.0.0.0/28

# ── Auth — runtime feature toggle (env locks UI toggle ON when set to true) ───────────────────────
KANDEV_FEATURES_AUTH=true
# Leave unset/false only for single-user private (127.0.0.1 + VPN/tailnet shielding). jwtSecret is NOT auth (G3).
# KANDEV_AUTH_JWTSECRET=   # compatibility-only, do not set hoping it adds auth
# KANDEV_AUTH_COOKIE_NAME= # empty → port-scoped auto (kandev_session vs kandev_session_<port>)

# ── Logging ────────────────────────────────────────────────────────────────────────────────────────
KANDEV_LOG_LEVEL=info
# KANDEV_LOGGING_FORMAT=text   # text vs json (auto json when KUBERNETES_SERVICE_HOST set)

# ── Database — choose ONE driver (see playbook §9.4 + §16.4 for migration) ───────────────────────
# SQLite inside home (default):
KANDEV_DATABASE_DRIVER=sqlite
# KANDEV_DATABASE_PATH=   # empty → <home>/data/kandev.db ; or /srv/kandev-data/kandev.db (custom outside home)

# SQLite custom path outside home (uncomment when P2 is outside home — requires second volume/dir + second backup sibling):
# KANDEV_DATABASE_PATH=/srv/kandev-data/kandev.db
# Postgres (external — uncomment all 7, wire password via secret file, see docker-compose.postgres.yml):
# KANDEV_DATABASE_DRIVER=postgres
# KANDEV_DATABASE_HOST=postgres
# KANDEV_DATABASE_PORT=5432
# KANDEV_DATABASE_USER=kandev
# KANDEV_DATABASE_PASSWORD="${KANDEV_DB_PASSWORD:?set KANDEV_DB_PASSWORD}"  # real value in 0600 file, never inline
# KANDEV_DATABASE_DBNAME=kandev
# KANDEV_DATABASE_SSLMODE=disable   # disable | require | verify-ca | verify-full

# ── Docker runtime (executor) ────────────────────────────────────────────────────────────────────
KANDEV_DOCKER_ENABLED=true
KANDEV_DOCKER_HOST=unix:///var/run/docker.sock
# KANDEV_DOCKER_APIVERSION=
# KANDEV_DOCKER_TLSVERIFY=false

# ── Executors — timeouts & extras ─────────────────────────────────────────────────────────────────
# KANDEV_TASK_PREPARATION_TIMEOUT=10m   # Go duration (90s, 10m, 1h); later added 5m for runtime creation
# KANDEV_GITHUB_CREDENTIAL_BROKER_PUBLIC_BASE_URL=https://<DOMAIN>  # SSH/Sprites/Docker need broker over HTTPS

# ── GitHub / agent credentials (resolved lazily, via secrets store or env) ───────────────────────
# ANTHROPIC_API_KEY=...   # injected via Settings > Secrets + profile, not here unless host-local fallback needed
# OPENAI_API_KEY=...
# KANDEV_CREDENTIALS_FILE=   # optional JSON fallback, flat string map, 0600 — see docs/configuration

# ── Office / feature flags (stable contract is KANDEV_FEATURES_*) ─────────────────────────────────
# KANDEV_OFFICE_JWTSIGNINGKEY=   # stable HMAC when Office tasks must survive restarts
# KANDEV_FEATURES_OFFICE=  KANDEV_FEATURES_CLAUDE_BACKGROUND_PROMPT_HANDOFF=  KANDEV_DEBUG_DEV_MODE=  # etc — rarely set; prefer Settings UI
