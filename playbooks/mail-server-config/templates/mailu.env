# Mailu environment — placeholder template. Copy to <MAILU_DIR>/mailu.env
# and fill every <PLACEHOLDER> from the run's plan.md + secrets/ folder.
# Real values NEVER go into the committed repo (AGENTS.md §1.5, §7).

# --- Core ---
# Primary mail domain handled by this server
DOMAIN=<DOMAIN>
# Hostnames the server answers for / TLS certificate covers (comma list)
HOSTNAMES=mail.<DOMAIN>
# Local part of the postmaster address (postmaster@<DOMAIN>)
POSTMASTER=<POSTMASTER_LOCAL_PART>
# Site name shown in the admin/webmail UI
SITENAME=Mail Server

# --- Secrets (from this run's secrets/, never inline) ---
# 16 chars, uppercase alphanumeric (generate: tr -dc 'A-Z0-9' </dev/urandom | head -c16)
SECRET_KEY=<SECRET_KEY_REF>
# Password used by Mailu internals between containers
RSPAMD_PASSWORD=<RSPAMD_PASSWORD_REF>

# --- Initial admin account (created at first start) ---
INITIAL_ADMIN_ACCOUNT=<ADMIN_USER>
INITIAL_ADMIN_DOMAIN=<DOMAIN>
INITIAL_ADMIN_PW=<ADMIN_PASSWORD_REF>
INITIAL_ADMIN_MODE=ifmissing

# --- Database backend ---
# small scale: sqlite (default, recommended by Mailu for single instance)
DB_FLAVOR=sqlite
# medium/large scale (postgres variant): uncomment and set
# DB_FLAVOR=postgresql
# SQLALCHEMY_DATABASE_URI=postgresql://<DB_USER>:<DB_PASSWORD_REF>@postgres/<DB_NAME>

# --- Components ---
# Virus scanning (ClamAV) — heavy but recommended
ANTIVIRUS=true
# Webmail: roundcube | none
WEBMAIL=roundcube
# WebDAV (files) — optional, usually false
WEBDAV=false
# Mail protocols offered by the front (imap/pop3/smtp protocol switches)
POP3=false

# --- TLS ---
# letsencrypt | cert (manual cert) | mail (self-signed at first start, not for prod)
TLS_FLAVOR=letsencrypt
# Account used for Let's Encrypt issuance
LETSENCRYPT_EMAIL=<POSTMASTER_LOCAL_PART>@<DOMAIN>
# For cert flavor only — paths to the manual certificate
# TLS_CERT_FLAVOR=...
# CERT_FILENAME=<CERT_PATH>
# KEY_FILENAME=<KEY_PATH>

# --- Misc (defaults; change only with a reason, record it) ---
# Disable administration of local domains by logged-in users other than admin
ADMIN=false
# Per-user login domain selection (multiple domains)
DOMAIN_REGISTRATION=false
# Log level: debug | info | warning | error
LOG_LEVEL=warning
# Timezone for logs and admin UI
TZ=<TIMEZONE>
# Container image org/prefix/version (kept in lockstep with docker-compose.yml)
DOCKER_ORG=mailu
DOCKER_PREFIX=mailu
MAILU_VERSION=<MAILU_VERSION>
# Compose project root dir (where this env file lives)
ROOT=<MAILU_DIR>
